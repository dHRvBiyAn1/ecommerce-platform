# Local development defaults. Copy this file to `.env` and change every
# `change_me_*` value before using the stack outside an isolated workstation.

# Spring and service discovery
SPRING_PROFILES_ACTIVE=local
EUREKA_DEFAULT_ZONE=http://discovery-server:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SEED_ENABLED=true

# PostgreSQL
APP_DB_NAME=ecommerce
APP_DB_USER=ecommerce
APP_DB_PASSWORD=change_me_postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB
MONGO_ROOT_USER=ecommerce
MONGO_ROOT_PASSWORD=change_me_mongo
MONGO_HOST=mongodb
MONGO_PORT=27017

# Redis and Elasticsearch
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Auth signing keys are generated by `make keys` and mounted as Compose secrets.
AUTH_RSA_PRIVATE_KEY_LOCATION=file:/run/secrets/auth-private.pem
AUTH_RSA_PUBLIC_KEY_LOCATION=file:/run/secrets/auth-public.pem
AUTH_RSA_KID=local-dev-key
AUTH_RSA_PREVIOUS_PUBLIC_KEY_LOCATION=
AUTH_RSA_PREVIOUS_KID=

# Bootstrap admin and browser-facing auth settings
AUTH_ADMIN_EMAIL=admin@local.test
AUTH_ADMIN_PASSWORD=change_me_admin
AUTH_ADMIN_DISPLAY_NAME=Platform Admin
SECURE_COOKIES=false
FRONTEND_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend build-time API base. Empty uses the static server's same-origin proxy.
FRONTEND_VITE_API_BASE_URL=

# Payments (empty Stripe values select the local sandbox gateway)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=change_me_payment_webhook

# Notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@local.test
WAREHOUSE_EMAIL=warehouse@local.test

# Observability
GRAFANA_PASSWORD=change_me_grafana
