# ============================================================================
# Ecommerce Platform — local development environment
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Use `./scripts/gen-keys.sh` to bootstrap RSA keys for the auth-service.
# ============================================================================

# ---- Auth-service RSA keypair (used to sign JWTs) ----
AUTH_RSA_PRIVATE_KEY_LOCATION=
AUTH_RSA_PUBLIC_KEY_LOCATION=
AUTH_RSA_KID=

# ---- Bootstrap admin (created on first start of auth-service) ----
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME=Platform Admin

# ---- Databases ----
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=ecommerce

MONGO_INITDB_ROOT_USERNAME=ecommerce
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo

REDIS_PASSWORD=change_me_redis

# ---- OAuth2 social login ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Stripe (test mode) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- Webhook signing for in-house webhooks ----
PAYMENT_WEBHOOK_SECRET=change_me_payment_webhook
SHIPPING_WEBHOOK_SECRET=change_me_shipping_webhook

# ---- Frontend URLs ----
FRONTEND_BASE_URL=http://localhost:4200
ADMIN_FRONTEND_URL=http://localhost:4300

# ---- External integrations (free tier / OSS) ----
EXCHANGE_RATE_API_BASE=https://api.exchangerate.host
NOMINATIM_API_BASE=https://nominatim.openstreetmap.org
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# ---- Observability ----
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
TEMPO_ENDPOINT=http://tempo:4318
